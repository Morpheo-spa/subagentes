# Estampa - environment template.
#
#   cp .env.example .env && make secrets      # fills every CHANGE_ME below
#
# Every variable read by backend/app/config.py is listed here, plus the ones the
# compose files need. Values marked CHANGE_ME are placeholders: the stack refuses
# to start without them and scripts/check_env.py rejects them in production.
#
#   python scripts/check_env.py .env.production
#
# Generate the secrets (never reuse these between environments):
#   JWT_SECRET_KEY      python -c "import secrets; print(secrets.token_urlsafe(48))"
#   STORAGE_SECRET_KEY  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   ACCESS_LOG_IP_SALT  python -c "import secrets; print(secrets.token_urlsafe(24))"
#   POSTGRES_PASSWORD   python -c "import secrets; print(secrets.token_urlsafe(24))"
#   REDIS_PASSWORD      python -c "import secrets; print(secrets.token_urlsafe(24))"
#   MINIO_ROOT_USER     python -c "import secrets; print('estampa-' + secrets.token_hex(4))"
#   MINIO_ROOT_PASSWORD python -c "import secrets; print(secrets.token_urlsafe(24))"
#
# STORAGE_SECRET_KEY must be a valid Fernet key (32 url-safe base64 bytes).
# Rotating it re-encrypts every stored storage credential: see docs/RUNBOOK.md.

# --- Runtime ----------------------------------------------------------------
ENVIRONMENT=local            # local | staging | production
DEBUG=false                  # true is development only: it makes SQLAlchemy log
                             # statements with their bound parameters (password
                             # hashes, viewer tokens) and re-enables /docs. The
                             # API refuses to start with DEBUG=true and
                             # ENVIRONMENT=production. docker-compose.dev.yml
                             # sets it to true for the local stack.
APP_NAME=Estampa
PUBLIC_BASE_URL=http://localhost     # base of the QR URLs. No trailing slash.
                                     # Must be https:// in production.
API_PREFIX=/api/v1

# Number of reverse proxies in front of the API. X-Forwarded-For is read from
# the RIGHT with this many hops, so a client-supplied prefix cannot forge the
# IP that ends up hashed into the legal access log. 1 = only Traefik. Keep it
# equal to ipStrategy.depth in infra/traefik/dynamic/middlewares.yml.
TRUSTED_PROXY_COUNT=1

# --- Persistence ------------------------------------------------------------
# Inside compose the hosts are `postgres` and `redis`; neither is published any
# more, so from the host they are only reachable with the dev overlay
# (localhost:5433 and localhost:6380).
#
# The password inside each URL must match POSTGRES_PASSWORD / REDIS_PASSWORD
# below; check_env.py compares them. `make secrets` keeps both halves in step.
DATABASE_URL=postgresql+asyncpg://estampa:CHANGE_ME_postgres_password@postgres:5432/estampa
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379/0

# --- Security ---------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_generate_a_48_byte_url_safe_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
STORAGE_SECRET_KEY=CHANGE_ME_generate_a_valid_fernet_key_32_bytes
ACCESS_LOG_IP_SALT=CHANGE_ME_generate_a_24_byte_salt

# --- Uploads ----------------------------------------------------------------
# 5 MB is the cap the Resolution of 5 June 2026 sets per DeCA file.
MAX_UPLOAD_MB=5
MAX_FILES_PER_UPLOAD=100

# --- Billing ----------------------------------------------------------------
# Off by default: the product runs unmetered without Stripe. Turning it on
# without both Stripe keys makes the API refuse to start, by design.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LOOKUP_PREFIX=estampa_

# --- Retention --------------------------------------------------------------
# 365 days is the legal minimum. Raising it is a business decision, not a bug.
DEFAULT_RETENTION_DAYS=365
RETENTION_SWEEP_HOUR_UTC=2

# --- TLS / Traefik ----------------------------------------------------------
# Static Traefik configuration mounted by docker-compose.yml. The default file
# redirects :80 to :443 and issues certificates with the ACME resolver. Copy it
# and point this at your copy to set the real ACME contact address without
# editing a tracked file; check_env.py reads whichever file this names and
# rejects a dashboard left insecure, TLS switched off, or the example address.
# See docs/RUNBOOK.md section 7.
TRAEFIK_STATIC_CONFIG=./infra/traefik/traefik.yml

# --- Compose services (not read by the API) ---------------------------------
# Postgres, Redis and MinIO all refuse to start without these; there are no
# built-in defaults any more (audit E-06).
POSTGRES_USER=estampa
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=estampa
REDIS_PASSWORD=CHANGE_ME_redis_password
MINIO_ROOT_USER=CHANGE_ME_minio_access_key
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_secret_key
VITE_API_BASE_URL=/api/v1
