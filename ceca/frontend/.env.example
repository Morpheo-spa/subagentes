# URL base de la API. Vacio = mismo origen (Traefik sirve /api junto al front).
# En desarrollo, dejalo relativo: el proxy de Vite (vite.config.ts) reenvia /api y
# /v al backend desde el MISMO origen. Hace falta para que la cookie HttpOnly del
# refresh (`estampa_refresh`, SameSite=strict) viaje y para que `POST /auth/refresh`
# no rechace la peticion con 403 CROSS_ORIGIN_REJECTED.
VITE_API_BASE_URL=/api/v1

# Origen publico usado para construir la URL del QR (https://dominio/v/<token>).
VITE_PUBLIC_BASE_URL=http://localhost:5173

# Solo desarrollo: destino del proxy de Vite para /api y /v.
VITE_DEV_API_PROXY=http://localhost:8000

# Y en backend/.env, para desarrollo con Vite:
#   PUBLIC_BASE_URL=http://localhost:5173   (exactamente la URL con la que abres Vite:
#                                            localhost y 127.0.0.1 son origenes distintos)
#   ENVIRONMENT=local                        (la cookie sin `Secure`, que en dev no hay TLS)
